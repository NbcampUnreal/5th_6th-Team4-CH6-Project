{
    "dialogues": [
        {
            "dialogueId": "D_TestQuest_Handsome_001_v1",
            "startNode": "N001",
            "nodes": [
                {
                    "id": "N001",
                    "speaker": "NPC_OldMan",
                    "text": "여행자여… 테스트 퀘스트를 하나 내겠네.",
                    "emit": [ "QuestEvent.Accepted.TestQuestHandsome" ],
                    "setFlags": [ "TestQuestHandsome_Accepted" ],
                    "choices": [
                        {
                            "text": "퀘스트를 받는다.",
                            "next": "N002"
                        },
                        {
                            "text": "나중에 올게요.",
                            "next": "END"
                        }
                    ]
                },
                {
                    "id": "N002",
                    "speaker": "NPC_OldMan",
                    "text": "4조 팀원들 중 가장 잘생긴 사람은?",
                    "choices": [
                        {
                            "text": "1. 정다훈",
                            "next": "N003real"
                        },
                        {
                            "text": "2. 김상원",
                            "next": "N003"
                        },
                        {
                            "text": "3. 조무현",
                            "next": "N003"
                        },
                        {
                            "text": "4. 서정민",
                            "next": "N003"
                        },
                        {
                            "text": "5. 박찬영",
                            "next": "N003"
                        }
                    ]
                },
                {
                    "id": "N003",
                    "speaker": "NPC_OldMan",
                    "text": "과연 그렇군. 근데 사실 1번이 더 정답이지 않을까? 퀘스트 통과다.",
                    "emit": [ "QuestEvent.Completed.TestQuestHandsome" ],
                    "setFlags": [ "TestQuestHandsome_Completed" ],
                    "choices": [
                        {
                            "text": "감사합니다.",
                            "next": "END"
                        }
                    ]
                },
                {
                    "id": "N003real",
                    "speaker": "NPC_OldMan",
                    "text": "확실히. 나도 1번이라고 생각한다네. 퀘스트 통과다.",
                    "emit": [ "QuestEvent.Completed.TestQuestHandsome" ],
                    "setFlags": [ "TestQuestHandsome_Completed" ],
                    "choices": [
                        {
                            "text": "사실이긴 해요.",
                            "next": "END"
                        }
                    ]
                }
            ]
        },

        {
            "dialogueId": "D_TestQuest_Eldest_001_v1",
            "startNode": "N001",
            "requiresFlags": [ "TestQuestHandsome_Completed" ],
            "nodes": [
                {
                    "id": "N001",
                    "speaker": "NPC_OldMan",
                    "text": "좋아. 다음 테스트 퀘스트를 주겠네.",
                    "emit": [ "QuestEvent.Accepted.TestQuestEldest" ],
                    "setFlags": [ "TestQuestEldest_Accepted" ],
                    "choices": [
                        {
                            "text": "퀘스트를 받는다.",
                            "next": "N002"
                        },
                        {
                            "text": "나중에 올게요.",
                            "next": "END"
                        }
                    ]
                },
                {
                    "id": "N002",
                    "speaker": "NPC_OldMan",
                    "text": "4조 팀원들 중 가장 연장자인 사람은?",
                    "choices": [
                        {
                            "text": "1. 정다훈",
                            "next": "N_FAIL"
                        },
                        {
                            "text": "2. 김상원",
                            "next": "N_FAIL"
                        },
                        {
                            "text": "3. 조무현",
                            "next": "N_SUCCESS"
                        },
                        {
                            "text": "4. 서정민",
                            "next": "N_FAIL"
                        },
                        {
                            "text": "5. 박찬영",
                            "next": "N_FAIL"
                        }
                    ]
                },
                {
                    "id": "N_SUCCESS",
                    "speaker": "NPC_OldMan",
                    "text": "연장자를 대우하려면 누가 가장 노인인지부터 파악해야하지. 퀘스트 통과다.",
                    "emit": [ "QuestEvent.Completed.TestQuestEldest" ],
                    "setFlags": [ "TestQuestEldest_Completed" ],
                    "choices": [
                        {
                            "text": "감사합니다.",
                            "next": "END"
                        }
                    ]
                },
                {
                    "id": "N_FAIL",
                    "speaker": "NPC_OldMan",
                    "text": "늙은이에 대한 존중이 없군.",
                    "emit": [ "QuestEvent.Failed.TestQuestEldest" ],
                    "choices": [
                        {
                            "text": "다시 한번 생각해볼께요.",
                            "next": "N002"
                        },
                        {
                            "text": "흥, 아무리 그래도 3번이 제일 젊어보여요.",
                            "next": "END"
                        }
                    ]
                }
            ]
        }
    ]
}